{
  "name": "shivdhara-medical",
  "private": true,
  "version": "1.6.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:electron": "electron .",
    "build:electron": "vite build && electron-builder --win --ia32"
  },
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "lucide-react": "^0.577.0",
    "mysql2": "^2.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uid": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^22.3.27",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.1"
  },

  "main": "electron/main.cjs",
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "sakhiyaavi4-sys",
        "repo": "shivdhara-medical",
        "releaseType": "release"
      }
    ],
    "appId": "com.shivdhara.medical",
    "productName": "Shivdhara Medical Store",
    "directories": {
      "output": "C:/temp_dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/server/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    },
    "asar": false
  }
}
